; Engine configuration file
; Godot 4.x — Virtual Rabbit MVP

config_version=5

[application]

config/name="Coelho Virtual"
config/description="Low-poly virtual rabbit — MVP with FSM, graph UI, Ollama stub"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BrainClient="*res://scripts/brain_client.gd"
PerceptionRegistry="*res://scripts/perception_registry.gd"
WikiLookup="*res://scripts/wiki_lookup.gd"
ResearchLog="*res://scripts/research_log.gd"
SketchArchive="*res://scripts/sketch_archive.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="rabbit"

[rendering]

textures/canvas_textures/default_texture_filter=0