# Ollama (local LLM)
BRAIN_API_URL=http://127.0.0.1:11434
BRAIN_MODEL=llama3.2:1b

# Brave Search (pesquisa na web) — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNT=5
BRAVE_FETCH_TOP_PAGE=false
# RESEARCH_URL_ALLOWLIST=brasilescola.uol.com.br,scielo.br
RITUAL_STOPS_REFLECT=5
# Segundos entre buscas Brave (default 1200 = 20 min). Vitrine 24/7: use 2700–3600.
RESEARCH_MIN_INTERVAL_SEC=1200
# Probabilidade de pesquisar após 1ª vez (0.0–1.0)
RESEARCH_SEARCH_CHANCE=0.3